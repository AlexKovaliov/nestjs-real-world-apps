# HTTP port (defaults to 3000; most hosting platforms set this for you)
PORT=3000

# PostgreSQL connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce

# Secret used to sign and verify JWTs (use a long random value in production)
JWT_SECRET=replace-with-a-long-random-secret

# Google Gemini API key, used to validate product descriptions
GEMINI_API_KEY=your-gemini-api-key
