# API gateway: secret used to sign and verify JWTs (required)
JWT_SECRET=replace-with-a-long-random-secret
# Password for the demo "admin" user (defaults to "changeme")
ADMIN_PASSWORD=changeme

# Optional: serve the API gateway over HTTPS
# TLS_KEY_PATH=certs/private-key.pem
# TLS_CERT_PATH=certs/public-certificate.pem
